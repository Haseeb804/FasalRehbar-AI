# ============================================================
# FasalRehbar AI — Environment Configuration Example
# Copy this file to `.env` and fill in your local values.
# ============================================================

# ── Django Core Settings ──────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database Configuration ────────────────────────────────────
# PostgreSQL example: postgres://user:password@localhost:5432/fasalrehbar_db
# SQLite fallback: sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# ── Email Settings ────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FasalRehbar AI <support@fasalrehbar.ai>

# ── Application Metadata ──────────────────────────────────────
SITE_NAME=FasalRehbar AI

# ── Machine Learning & Neural Pipeline ─────────────────────────
ML_MODELS_DIR=saved_models
ML_DEVICE=cpu
ML_IMG_SIZE=224

# ── Generative AI & Knowledge Retrieval (Optional) ────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Multi-Agent Advisory Pipeline (CrewAI) ────────────────────
USE_CREWAI_PIPELINE=False
CREWAI_LLM_MODEL=gpt-4o-mini
